@startuml
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70

' ==========================================
' ENUMS
' ==========================================
enum StatusSessao {
    SOLICITADA
    CONFIRMADA
    REALIZADA
    CANCELADA
    REJEITADA
}

enum TipoResponsavel {
    PAI
    MAE
    TUTOR
    OUTRO
    NENHUM
    PROPRIO
}

enum StatusPresenca {
    PRESENTE
    AUSENTE
    JUSTIFICADO
    DESISTENTE
}

' ==========================================
' AGREGADOR RAIZ / SISTEMA (PKZLab)
' ==========================================
class PKZLab {
    "Agregador Raiz do sistema, responsável por gerenciar usuários, salas e sessões.
    No caso desse projeto é o sistema Django, que gerencia o banco de dados e as regras de negócio."
}

' ==========================================
' HIERARQUIA DE USUÁRIOS
' ==========================================

abstract class AbstractUser {
    - id: integer
    - password: string
    - last_login: datetime
    - is_superuser: boolean
    - username: string
    - first_name: string
    - last_name: string
    - email: string
    - is_staff: boolean
    - is_active: boolean
    - date_joined: datetime
    + get_full_name()
    + get_short_name()
    + email_user(subject, message)
    + set_password(raw_password)
    + check_password(raw_password)
    + has_usable_password()
    + get_username()
    + get_all_permissions()
    + get_user_permissions()
    + get_group_permissions()
    + has_perm(perm)
    + has_perms(perm_list)
    + has_module_perms(app_label)
}

abstract class Usuario {
    - telefone: String
    - dataNascimento: Date
    - endereco: String
}

class Administrador {
    - tipoContrato: String
    + cadastrarUsuario(usuario: Usuario): void
    + desativarUsuario(usuario: Usuario): void
    + cadastrarSala(sala: Sala): void
    + aprovarSessao(sessao: Sessao): void
    + desaprovarSessao(sessao: Sessao, motivo: String): void
}

class Responsavel {
    + adicionarDependente(aluno: Aluno): void
    + removerDependente(aluno: Aluno): void
    + transferirResponsabilidade(aluno: Aluno, novoResponsavel: Responsavel): void
    + inscreverEmSessao(aluno: Aluno, sessao: Sessao): Sessao
    + cancelarInscricaoEmSessao(aluno: Aluno, sessao: Sessao, motivo: String): void
}

class Aluno {
    - matricula: String Unique
    - responsavel: TipoResponsavel
    - creditos: int
    + inscreverEmSessao(sessao: Sessao): void
    + cancelarInscricao(sessao: Sessao, motivo: String): void
    + assumirTutoria(): void
}

abstract class Profissional {
    - tipoContrato: String
    - formacao: String
    + solicitarSessao(sala: Sala, dataHora: DateTime, duracao: TimeSpan, creditosNecessarios: int): Sessao
    + cancelarSessao(sessao: Sessao, motivo: String): void
    + gerarLaudo(sessao: Sessao, aluno: Aluno, linkArquivo: String): Laudo
}

class Treinador {
    - especialidade: String
}

class Nutricionista {
    - CRN: String Unique
}

class Psicologo {
    - CRP: String Unique
}

class Fisioterapeuta{
    - CREFITO: String Unique
}

AbstractUser <|-- Usuario

Usuario <|-- Administrador
Usuario <|-- Responsavel
Usuario <|-- Aluno
Usuario <|-- Profissional

Profissional <|-- Treinador
Profissional <|-- Nutricionista
Profissional <|-- Psicologo
Profissional <|-- Fisioterapeuta

Responsavel "0..1" o-- "1..*" Aluno

TipoResponsavel -[hidden]left-> Aluno

' ==========================================
' SESSÃO, SALA E AGENDAMENTO
' ==========================================
class Sala {
    - id: int
    - numero: int
    - capacidade: int
    - interditada: boolean
    + interditar(): void
    + desinterditar(): void
    + verificarDisponibilidade(dataHora: DateTime, duracao: TimeSpan): boolean
}

class Sessao {
    - id: int
    - dataHora: DateTime
    - duracao: TimeSpan
    - status: StatusSessao
    - creditosNecessarios: int
    - motivoCancelamento: String
    + solicitar(cls, profissional, sala, dataHora, duracao, creditosNecessarios): Sessao
    + confirmar(): void
    + rejeitar(motivo: String): void
    + cancelar(motivo: String): void
    + inscreverAluno(aluno: Aluno): void
    + removerAluno(aluno: Aluno): void
    + registrarPresenca(aluno: Aluno, presente: StatusPresenca, justificativa: String): void
}

class Presenca {
    - id: int
    - status: StatusPresenca
    - justificativa: String
    + registrarPresenca(status: StatusPresenca, justificativa: String): void
}

class Laudo {
    "Ainda está sendo definido como será implementado o laudo"
    - id: int
    - dataGeracao: Date
    - linkArquivo: String
}

' ==========================================
' RELACIONAMENTOS DO PKZLab E ADMINISTRAÇÃO
' ==========================================
PKZLab "1" o-- "0..*" Usuario
PKZLab "1" *-- "0..*" Sala
PKZLab "1" *-- "0..*" Sessao

Administrador ..> PKZLab

' ==========================================
' RELACIONAMENTOS OPERACIONAIS
' ==========================================
Profissional "1" <-- "0..*" Sessao
Sala "1" <-- "0..*" Sessao

Sessao "1" *-- "0..*" Presenca
Presenca "0..*" --> "1" Aluno

StatusPresenca -[hidden]right-> Sessao

Sessao "1" <-- "0..*" Laudo
Laudo "0..*" --> "1" Aluno

StatusSessao -[hidden]left-> Sessao

@enduml