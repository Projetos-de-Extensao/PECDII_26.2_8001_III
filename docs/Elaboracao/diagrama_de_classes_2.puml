@startuml

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 60

' ==========================================
' DECLARAÇÃO DAS CLASSES
' ==========================================

abstract class Usuario {
    + Nome: String
    + Email: String
    + Telefone: String
    + DataNascimento: Date
    + realizarLogin()
    + realizarLogout()
    + verificarCredenciais()
    + atualizarSenha()
}

class Administrador {
    + cadastrarUsuario()
    + removerUsuario()
    + atualizarUsuario()
    + cadastrarSala()
    + removerSala()
    + atualizarSala()
    + criarSessao()
    + cancelarSessao()
    + atualizarSessao()
}

class Responsavel {
    + Endereco: String
}

class Aluno {
    + Matricula: String
    + Endereco: String
}

abstract class Profissional {
    + Contrato: String
}

class Professor {
}

class Psicologo {
}

class Nutricionista {
}

class PKZLab {
    + adicionarUsuario()
    + removerUsuario()
    + atualizarUsuario()
    + cadastrarSala()
    + removerSala()
    + atualizarSala()
    + criarSessao()
    + cancelarSessao()
    + atualizarSessao()
}

class Relatorio {
    + GerarRelatorio()
}

class Sala {
    + Numero: int
    + Capacidade: int
}

class Sessao {
    + DataHora: DateTime
    + Duracao: TimeSpan
}

class Presenca {
    + Status: boolean
    + registrarPresenca()
}

' ==========================================
' ESTRUTURA DE GRADE (ALINHAMENTO VISUAL)
' ==========================================

' --- LINHA 1 para LINHA 2: Herança de Usuario ---
Usuario <|-- Administrador
Usuario <|-- Responsavel
Usuario <|-- Aluno
Usuario <|-- Profissional

' Trava a ordem horizontal da Linha 2:
Administrador -[hidden]right-> Responsavel
Responsavel "1" <-right-> "0..*" Aluno
Aluno -[hidden]right-> Profissional

' --- Herança de Profissional (Empilhados à Direita) ---
' 1. Posiciona as 3 subclasses na coluna à direita de Profissional:
Profissional <|-right- Psicologo
Profissional <|-right- Nutricionista
Profissional <|-right- Professor

' --- LINHA 2 para LINHA 3: PKZLab (Esquerda) e Relatorio (Centro-Direita) ---
Administrador "0..*" --> "1" PKZLab
Responsavel "0..*" <--o "1" PKZLab
Aluno "0..*" <--o "1" PKZLab
Profissional "0..*" <--o "1" PKZLab

Aluno "1" <-up-> "0..*" Relatorio
Profissional "1" <--> "0..*" Relatorio

' --- LINHA 3 para LINHA 4: Sala, Sessao e Presenca ---
PKZLab "1" o--> "0..*" Sala
PKZLab "1" o--> "0..*" Sessao

Aluno "0..*" <---> "0..*" Sessao
Profissional "1" <---> "0..*" Sessao

' Trava a ordem horizontal da Linha 4 (Base):
Sala "1" <-right-> "0..*" Sessao
Sessao "1" *-down-> "0..*" Presenca

@enduml